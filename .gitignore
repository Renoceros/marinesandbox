# ==========================================
# macOS System Files
# ==========================================
.DS_Store
.AppleDouble
.LSOverride
._*

# ==========================================
# Xcode User & Build Artifacts (Prevents Merge Conflicts)
# ==========================================
xcuserdata/
*.xcuserstate
DerivedData/
build/

# ==========================================
# App Packaging & Playgrounds
# ==========================================
*.ipa
*.dSYM.zip
*.dSYM
timeline.xctimeline
playground.xcworkspace

# ==========================================
# Swift Package Manager & Code Structure
# ==========================================
.build/
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcodeproj/project.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata

# ==========================================
# Supabase credentials (never commit)
# ==========================================
marinesandbox/Supabase.plist

# ==========================================
# CI/CD Automation (Fastlane)
# ==========================================
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# ==========================================
# Codebase Documentation
# ==========================================
codebase_understanding.md

# ==========================================
# AI Coding Agents & Assistants
# ==========================================
.aider.chat.history.md
.aider.input.history
.aider.tags.cache.v*
.cursor-history/
.cursor/
!.cursor/rules/
.claude/
.claude-history/
.copilot/
.gemini/
.openai/

# ==========================================
# Python Virtual Environments & Cache
# ==========================================
venv/
.venv/
env/
.env/
__pycache__/
*.pyc

# ==========================================
# Media Files in Transcription
# ==========================================
/Documentation/Transcription/*.m4a
/Documentation/*.svg
/Documentation/*.png